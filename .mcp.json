{
  "mcpServers": {
    "shadcn": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "shadcn@latest", "mcp"]
    },
    "magicui": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@magicuidesign/mcp@latest"]
    },
    "aceternityui": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "aceternityui-mcp"]
    },
    "reactbits": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "reactbits-dev-mcp-server"]
    }
  }
}
